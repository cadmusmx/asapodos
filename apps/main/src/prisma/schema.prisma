  Description  String?        @db.NVarChar(500)
  IsActive     Boolean        @default(true, map: "DF__Areas__IsActive__5E6AD939")
  CreatedAt    DateTime       @default(dbgenerated("sysutcdatetime()"), map: "DF__Areas__CreatedAt__5F5EFD72")
  UpdatedAt    DateTime       @default(dbgenerated("sysutcdatetime()"), map: "DF__Areas__UpdatedAt__605321AB")
