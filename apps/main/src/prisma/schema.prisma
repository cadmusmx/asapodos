  UpdatedBy    Int?
  EmployeeData EmployeeData[]

  @@id([TenantID, AreaID], map: "PK_HC_Areas")
  @@unique([TenantID, Name], map: "UX_HC_Areas_Tenant_Name")
  @@schema("HumanCapital")
}

